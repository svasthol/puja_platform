#cloud-config
# Oracle Linux 9: package "docker" alone is not Docker CE — install from Docker repo.
write_files:
  - path: /var/lib/mana-guruji/install-redis-docker.sh
    permissions: "0755"
    owner:
      name: root
      group: root
    content: |
      #!/bin/bash
      set -euxo pipefail
      exec > /var/log/mana-guruji-redis-bootstrap.log 2>&1
      echo "=== mana-guruji redis micro bootstrap $(date -Iseconds) ==="
      dnf -y install dnf-plugins-core curl
      if [[ ! -f /etc/yum.repos.d/docker-ce.repo ]]; then
        dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
      fi
      dnf -y install docker-ce docker-ce-cli containerd.io
      systemctl enable --now docker
      usermod -aG docker opc || true
      docker pull ${redis_image}
      docker rm -f mana-guruji-redis 2>/dev/null || true
      docker run -d --name mana-guruji-redis --restart unless-stopped \
        -p 0.0.0.0:6379:6379 ${redis_image} \
        redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
      docker ps
      redis-cli -h 127.0.0.1 ping
      echo "=== bootstrap OK ==="

runcmd:
  - [bash, -lc, "/var/lib/mana-guruji/install-redis-docker.sh"]

final_message: "mana-guruji redis micro cloud-init finished after $UPTIME seconds"
