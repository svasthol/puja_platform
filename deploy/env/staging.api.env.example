# Copy to /etc/mana-guruji/api.env on stg-aio-1 (root:root 0600). Never commit real file.
APP_ENV=staging
DEBUG=false
SECRET_KEY=REPLACE_openssl_rand_hex_32

ALLOWED_ORIGINS=["http://140.245.245.201:3000","http://localhost:3000","http://127.0.0.1:3000","https://admin-staging.example.com"]

# Runtime (puja_app) — local Postgres on aio host
DATABASE_URL=postgresql+psycopg://puja_app:REPLACE@127.0.0.1:5432/Mana_Guruji
# Passwords with @ must be URL-encoded as %40 in these URLs (e.g. Mahadeva%40123).
DATABASE_MIGRATE_URL=postgresql://puja_migrate:REPLACE@127.0.0.1:5432/Mana_Guruji
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@127.0.0.1:5432/Mana_Guruji

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
# Redis (external host or stg-redis-1). REDIS_URL path is default/cache host; indices below are logical DBs.
# Example external: REDIS_URL=redis://18.60.87.153:6379/0
# No CREATE DATABASE — run: python scripts/ensure_redis_logical_dbs.py (or Actions → Redis ensure staging)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
REDIS_DB_PRESENCE=2

PLATFORM_TIMEZONE=Asia/Kolkata
FULL_ONLINE_ENABLED=false
TDS_ACCRUAL_ENABLED=false

RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE

# Phase 1 — OCI Object Storage (catalog images + KYC docs). One key pair; no duplicate S3_* lines.
# Rollout: spec/plans/STAGING_CONFIG_ROLLOUT.md · Verify: scripts/verify_staging_storage.py
# GitHub: Actions → "Staging storage smoke"
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
S3_REGION=ap-hyderabad-1
S3_BUCKET_CATALOG=mana-guruji-stg-catalog
S3_BUCKET_KYC=mana-guruji-stg-kyc
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
# Optional belt-and-suspenders if an older client omits Config checksum flags (boto3 >= 1.36 + OCI):
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
# S3_CATALOG_PUBLIC_URL=   # optional CDN/public base for catalogue URLs ONLY — never for KYC

# Phase 3 — Partner KYC (Setu) + same code as dev/prod; only env values differ.
# Register in Setu dashboard the URL *without* query string (app appends kyc_nonce).
# End-to-end: spec/plans/KYC_ONBOARDING.md · rollout: STAGING_CONFIG_ROLLOUT.md Phase 3
KYC_VENDOR=setu_digilocker
KYC_REDIRECT_URL=https://api-stg.managuruji.in/v1/pujari/kyc/callback
KYC_APP_RETURN_URL=managuruji://kyc/complete
KYC_IDENTITY_PEPPER=REPLACE_openssl_rand_hex_32_stable_per_database
KYC_SETU_BASE_URL=https://dg-sandbox.setu.co
KYC_SETU_CLIENT_ID=REPLACE
KYC_SETU_CLIENT_SECRET=REPLACE
KYC_SETU_DIGILOCKER_PRODUCT_ID=REPLACE
KYC_SETU_PAN_PRODUCT_ID=REPLACE

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEYS=REPLACE_FERNET_KEY
FCM_SERVICE_ACCOUNT_PATH=/etc/mana-guruji/firebase-service-account.json
